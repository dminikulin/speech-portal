{
  "routes": [
    {
      "route": "/api/*",
      "methods": ["GET", "POST", "DELETE", "OPTIONS"],
      "rewrite": "https://speechportal-func-app.azurewebsites.net/api/*"
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/fonts/*", "*.{png,jpg,jpeg,gif,svg,ico,css,js}"]
  }
}
